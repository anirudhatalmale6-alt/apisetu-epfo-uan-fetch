# Copy this file to .env and fill in the values. Never commit .env.
#
# Both credentials come from the APISetu Partners portal (apisetu.gov.in):
#   APISETU_API_KEY    Consume APIs -> API Keys -> Create API Keys.
#                      Shown ONCE at creation. If you lose it, generate a new one.
#   APISETU_CLIENT_ID  Also labelled Issuer ID. Bottom-left of the portal sidebar.
APISETU_API_KEY=
APISETU_CLIENT_ID=

# Live EPFO collection. Point this at the mock server to rehearse without credentials:
#   APISETU_BASE_URL=http://127.0.0.1:8099/epfindia/v3
APISETU_BASE_URL=https://apisetu.gov.in/epfindia/v3

# --- Consent artifact ------------------------------------------------------
# Off by default. The endpoint does not require it, and the artifact carries a
# mandatory signature field whose algorithm EPFO have not published. Ask EPFO
# whether they expect one before switching this on. Requests are recorded in
# output/audit.jsonl either way.
APISETU_SEND_CONSENT=false
CONSENT_DATA_CONSUMER_ID=
CONSENT_DATA_PROVIDER_ID=EPFO
CONSENT_VALIDITY_DAYS=30
CONSENT_PURPOSE=Employer verification of employee UAN records

# --- Throughput ------------------------------------------------------------
# EPFO publish no rate limit for this endpoint, so the default is deliberately
# gentle. Raise it only once you know what they actually allow.
REQUESTS_PER_SECOND=2
MAX_RETRIES=3
BACKOFF_SECONDS=2
TIMEOUT_SECONDS=60

# --- PDF acceptance --------------------------------------------------------
MAX_PDF_BYTES=10485760
MIN_PDF_BYTES=512
# Rotate any landscape page upright so every filed card opens the same way.
NORMALISE_ORIENTATION=true

OUTPUT_DIR=output
